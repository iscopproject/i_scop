# ============================================================
# ENVIRONMENT VARIABLES — copy to .env.local and fill in values
# ============================================================

# Supabase project URL (found in: Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in: Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — NEVER expose this client-side
# (found in: Project Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — used to sign session tokens; use a long random string
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-string

# Supabase storage bucket names (create these in Supabase Dashboard > Storage)
SUPABASE_ANNOUNCEMENTS_BUCKET=announcements
SUPABASE_ACHIEVEMENTS_BUCKET=achievements
